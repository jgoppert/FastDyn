+#     guest halts at the first translation-block boundary at or after the
+#     deadline, typically overshooting by a fixed cost of roughly one
+#     execution round.  When true it halts precisely on the deadline, so
+#     @currenttime equals @totalbudget after every slice.
 #
 # Since: 1.2
 ##
 { 'struct': 'Budget', 
-  'data': { 'totalbudget': 'uint64' } }
