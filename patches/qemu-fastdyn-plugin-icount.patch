+
+##
+# @set-budget-mode:
+#
+# Choose how the guest halts when its budget deadline is reached.
+#
+# @exact: true to halt precisely on the deadline.  This stops the VM
+#     synchronously from the deadline timer instead of raising an
+#     asynchronous stop request, which costs a vCPU pause on the main loop but
+#     removes the overshoot entirely.  Off by default, so existing behaviour is
+#     unchanged unless a master asks for it.
+#
+# Returns: the resulting budget state.
+#
+# Since: 1.2
+#
+# .. qmp-example::
+#
+#     -> { "execute": "set-budget-mode", "arguments": { "exact": true } }
+#     <- { "return": { "totalbudget": 0, "currenttime": 0, "exact": true } }
+##
+{ 'command': 'set-budget-mode',
+  'data': { 'exact': 'bool' },
+  'returns': 'Budget',
+  'allow-preconfig': true }
+
+##
+# @query-budget:
+#
+# Report the guest's current virtual time and cumulative budget deadline
+# without granting any further execution.  Intended for a co-simulation master
+# to read the guest's position after a STOP event.
+#
+# Returns: the current budget state.
+#
+# Since: 1.2
+#
+# .. qmp-example::
+#
+#     -> { "execute": "query-budget" }
+#     <- { "return": { "totalbudget": 20000000, "currenttime": 20000512 } }
+##
+{ 'command': 'query-budget',
+  'returns': 'Budget',
+  'allow-preconfig': true }
 ##
